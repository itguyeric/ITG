FROM quay.io/fedora/fedora-bootc:latest
LABEL maintainer="eric@itguyeric.com"

# --- USERS ---
RUN groupadd -g 1000 ansible && useradd -u 1000 -g 1000 -G wheel -m -s /bin/bash ansible && \
    groupadd -g 1001 itguyeric && useradd -u 1001 -g 1001 -G wheel -m -s /bin/bash itguyeric && \
    groupadd -g 2000 worker && useradd -u 2000 -g 2000 -m -s /bin/bash worker

RUN echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/wheel-nopasswd && \
    chmod 440 /etc/sudoers.d/wheel-nopasswd

RUN mkdir -p /etc/ssh/authorized_keys
COPY ansible/roles/common/files/id_rsa_ans.pub /etc/ssh/authorized_keys/ansible
COPY ansible/roles/common/files/id_rsa_itg.pub /etc/ssh/authorized_keys/itguyeric
RUN chmod 700 /etc/ssh/authorized_keys && chmod 600 /etc/ssh/authorized_keys/* && \
    echo 'AuthorizedKeysFile /etc/ssh/authorized_keys/%u' >> /etc/ssh/sshd_config

# --- WORKLOADS ---
RUN dnf clean all && dnf update -y && dnf install -y podman qemu-guest-agent tuned vim-enhanced

RUN systemctl enable podman.socket qemu-guest-agent sshd

# --- CLEANUP ---
RUN dnf clean all && rm /var/{cache,lib}/dnf /var/lib/rhsm /var/cache/ldconfig -rf
RUN bootc container lint

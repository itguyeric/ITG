[Unit]
Description=Initialize the forge data disk on first boot
DefaultDependencies=no
After=local-fs-pre.target
Before=var-lib-forge.mount
ConditionPathExists=/dev/disk/by-path/pci-0000:06:05.0-scsi-0:0:0:1
ConditionPathExists=!/dev/disk/by-label/dataForge

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/mkfs.xfs -L dataForge /dev/disk/by-path/pci-0000:06:05.0-scsi-0:0:0:1

[Install]
WantedBy=local-fs.target

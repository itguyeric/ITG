global:
  checkNewVersion: false
  #sendAnonymousUseage: false

log:
  filePath: "/traefik.log"
  format: common
  level: INFO

#accessLog:
  #filePath: "/traefik-access.log"
  #bufferingSize: 100

api:
  insecure: true

entryPoints:
  http:
    address: :80
    http:
      redirections:
        entryPoint:
          to: https
          scheme: https
  https:
    address: ":443"
    http:
      tls:
        certResolver: letsEncyrpt
        domains:
          - main: "*.home.itguyeric.com"
            sans:
              - "*.home.itguyeric.com"              

#certificatesResolvers:
#  letsEncrypt:
#    acme:
#      #caServer: "https://acme-v02.api.letsencrypt.org/directory"
#      caServer: "https://acme-staging-v2.api.letsencrypt.org/directory"
#      email: "contact@itguyeric.com"
#      storage: "/etc/traefik/acme.json"
#      dnsChallenge:
#        provider: digitalocean
#        delayBeforeCheck: 0
#          #: "/etc/traefik/.digitalocean" 

providers:
  #  docker:
  #  endpoint: unix///var/run/docker.sock
  #  exposedByDefault: false
  file:
    directory: /etc/traefik/dynamic/
    watch: true

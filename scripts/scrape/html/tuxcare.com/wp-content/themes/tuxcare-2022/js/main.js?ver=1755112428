// video starts when user scroll
document.addEventListener("DOMContentLoaded", () => {
    const videos = document.querySelectorAll("video");

    const playVideoOnScroll = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.play();
        } else {
            entry.target.pause();
            entry.target.currentTime = 0; // Optional: reset video position if needed
        }
        });
    }, { threshold: 0.5 });

    videos.forEach(video => {
        playVideoOnScroll.observe(video);
    });
});

// Expandable details on custom linux kernel page
document.addEventListener('click', (e) => {
    if (e.target.classList.contains('click-for-detail') || e.target.closest('.click-for-detail')) {
        const button = e.target.closest('.click-for-detail'); // Ensure we get the button
        const parentDiv = button.closest('.custom-linux-section-2-item'); // Find the parent container
        const detailDiv = parentDiv.querySelector('.text-expand'); // Find the details div inside the same parent
        const img = button.querySelector('img'); // Get the image inside the button

        // Toggle visibility
        detailDiv.classList.toggle('expanded');

        // Change image source based on state
        if (detailDiv.classList.contains('expanded')) {
            img.src = '/wp-content/uploads/2025/03/expanded-bottom.png'; // Replace with actual expanded image path
        } else {
            img.src = '/wp-content/uploads/2025/03/expand-bottom.png'; // Replace with actual collapsed image path
        }
    }
});

// AI Chatbot
document.addEventListener('DOMContentLoaded', function() {
    var chatWidget = document.querySelector('.chat-widget');
    var chatToggleButton = document.getElementById('chatToggleButton');
    var closeChat = document.getElementById('closeChat');
    var chatToggleText = document.getElementById('chatToggleText');

    if (chatWidget) {
        chatWidget.style.display = 'none';
    }

    if (chatToggleButton) {
        chatToggleButton.addEventListener('click', function (event) {
            event.preventDefault();

            if (chatWidget.style.display === 'none') {
                chatWidget.style.display = 'block';
                chatToggleButton.classList.add('hidden');
                chatToggleText.style.display = 'none';
                chatToggleButton.style.boxShadow = 'none';
            } else {
                chatWidget.style.display = 'none';
                chatToggleButton.classList.remove('hidden');
                chatToggleText.style.display = 'block';
                chatToggleButton.style.boxShadow = '0 0 10px rgba(255, 255, 255, 0.7)';
            }
        });
    }

    if (closeChat) {
        closeChat.addEventListener('click', function () {
            chatWidget.style.display = 'none';
            chatToggleButton.classList.remove('hidden');
            chatToggleText.style.display = 'block';
            chatToggleButton.style.boxShadow = '0 0 10px rgba(255, 255, 255, 0.7)';
            // remove chatToggleText completely
            chatToggleText.style.display = 'none';
        });
    }
});